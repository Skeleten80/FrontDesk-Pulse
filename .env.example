# Application
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/frontdesk_pulse?schema=public
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Provider mode: mock | hybrid | live
PROVIDER_MODE=mock
AI_PROVIDER=mock
TELEPHONY_PROVIDER=mock
SMS_PROVIDER=mock
CALENDAR_PROVIDER=mock

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VALIDATE_SIGNATURE=true

# Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
CALCOM_API_KEY=

# Security
ENCRYPTION_KEY=replace-with-32-byte-hex-or-base64-key
CRON_SECRET=replace-with-cron-secret

# Demo
DEMO_MODE=true
SEED_DEMO_PASSWORD=DemoOwner123!
