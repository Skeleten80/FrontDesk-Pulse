generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  PENDING_SETUP
  ACTIVE
  SUSPENDED
  DISABLED
}

enum MembershipRole {
  OWNER
  STAFF
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  RINGING
  IN_PROGRESS
  COMPLETED
  FAILED
  BUSY
  NO_ANSWER
  CANCELED
}

enum CallIntent {
  GENERAL_INFORMATION
  APPOINTMENT_REQUEST
  QUOTE_REQUEST
  NEW_LEAD
  EXISTING_CUSTOMER
  SUPPORT_REQUEST
  BILLING_QUESTION
  EMERGENCY_REQUEST
  SPAM
  OTHER
}

enum CallOutcome {
  INFORMATION_PROVIDED
  LEAD_CAPTURED
  APPOINTMENT_BOOKED
  ESCALATED
  VOICEMAIL
  ABANDONED
  SPAM
  UNRESOLVED
  OTHER
}

enum ResolutionStatus {
  RESOLVED
  NEEDS_FOLLOW_UP
  ESCALATED
  UNRESOLVED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  APPOINTMENT_BOOKED
  QUOTE_REQUESTED
  WON
  LOST
  UNRESPONSIVE
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeadSource {
  PHONE
  SMS
  WEB
  MANUAL
  OTHER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SmsDirection {
  INBOUND
  OUTBOUND
}

enum SmsStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  RECEIVED
}

enum KbSourceType {
  FAQ
  DOCUMENT
  POLICY
  SERVICE_DESCRIPTION
  PRICING_GUIDANCE
  MANUAL
}

enum KbDocumentStatus {
  DRAFT
  PROCESSING
  READY
  FAILED
}

enum IntegrationProvider {
  TWILIO
  GOOGLE_CALENDAR
  CALCOM
  OPENAI
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  PENDING
}

enum NotificationType {
  HIGH_PRIORITY_LEAD
  EMERGENCY_ESCALATION
  FAILED_CALL_TRANSFER
  CALENDAR_INTEGRATION_FAILURE
  OVERDUE_FOLLOW_UP
  REPEATED_CALLER_FRUSTRATION
  HEALTH_SCORE_DROP
  TWILIO_WEBHOOK_FAILURE
  KNOWLEDGE_BASE_INGESTION_FAILURE
  INTEGRATION_ERROR
  GENERAL
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
  MIXED
}

model User {
  id             String   @id @default(cuid())
  authProviderId String   @unique
  name           String
  email          String   @unique
  passwordHash   String?
  isPlatformAdmin Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships          TenantMembership[]
  assignedLeads        Lead[]             @relation("LeadAssignee")
  assignedAppointments Appointment[]      @relation("AppointmentAssignee")
  assignedTasks        FollowUpTask[]     @relation("TaskAssignee")
  auditLogs            AuditLog[]
  notifications        Notification[]
  accounts             Account[]
  sessions             Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Tenant {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  industry    String
  phoneNumber String?
  timezone    String       @default("America/Toronto")
  status      TenantStatus @default(PENDING_SETUP)
  isDemo      Boolean      @default(false)
  dataRetentionDays Int    @default(365)
  recordingConsentEnabled Boolean @default(true)
  recordingConsentMessage String?
  activatedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  memberships               TenantMembership[]
  businessProfile           BusinessProfile?
  receptionistConfiguration ReceptionistConfiguration?
  knowledgeBaseDocuments    KnowledgeBaseDocument[]
  knowledgeBaseChunks       KnowledgeBaseChunk[]
  callers                   Caller[]
  calls                     Call[]
  callEvents                CallEvent[]
  leads                     Lead[]
  appointments              Appointment[]
  followUpTasks             FollowUpTask[]
  smsMessages               SmsMessage[]
  healthScoreSnapshots      HealthScoreSnapshot[]
  integrationConnections    IntegrationConnection[]
  auditLogs                 AuditLog[]
  notifications             Notification[]
  inboundNumbers            TwilioInboundNumber[]
  activityEvents            ActivityEvent[]
}

model TenantMembership {
  id        String         @id @default(cuid())
  tenantId  String
  userId    String
  role      MembershipRole
  createdAt DateTime       @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

model BusinessProfile {
  id                     String   @id @default(cuid())
  tenantId               String   @unique
  legalName              String
  publicName             String
  description            String?
  address                String?
  city                   String?
  provinceOrState        String?
  postalCode             String?
  country                String   @default("CA")
  timezone               String   @default("America/Toronto")
  website                String?
  publicEmail            String?
  mainPhone              String?
  businessHours          Json
  holidayHours           Json?
  services               Json
  serviceArea            Json?
  appointmentRules       Json?
  emergencyInstructions  String?
  escalationInstructions String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model ReceptionistConfiguration {
  id                      String   @id @default(cuid())
  tenantId                String   @unique
  assistantName           String   @default("Alex")
  greeting                String
  speakingStyle           String   @default("professional")
  language                String   @default("en-CA")
  voiceProvider           String   @default("mock")
  voiceId                 String?
  allowAppointmentBooking Boolean  @default(true)
  allowSmsFollowUp        Boolean  @default(true)
  allowCallTransfer       Boolean  @default(false)
  transferNumber          String?
  fallbackMessage         String
  afterHoursMessage       String
  prohibitedTopics        Json?
  escalationRules         Json?
  industryQualificationHints Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model KnowledgeBaseDocument {
  id               String           @id @default(cuid())
  tenantId         String
  title            String
  sourceType       KbSourceType
  originalFileName String?
  content          String
  status           KbDocumentStatus @default(DRAFT)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  tenant Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunks KnowledgeBaseChunk[]

  @@index([tenantId, status])
}

model KnowledgeBaseChunk {
  id                 String   @id @default(cuid())
  tenantId           String
  documentId         String
  content            String
  embeddingReference String?
  metadata           Json?
  createdAt          DateTime @default(now())

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document KnowledgeBaseDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId, documentId])
}

model Caller {
  id          String    @id @default(cuid())
  tenantId    String
  phoneNumber String
  firstName   String?
  lastName    String?
  email       String?
  companyName String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  calls        Call[]
  leads        Lead[]
  appointments Appointment[]
  smsMessages  SmsMessage[]

  @@unique([tenantId, phoneNumber])
  @@index([tenantId, phoneNumber])
}

model Call {
  id                 String            @id @default(cuid())
  tenantId           String
  callerId           String
  twilioCallSid      String            @unique
  direction          CallDirection     @default(INBOUND)
  status             CallStatus        @default(RINGING)
  startedAt          DateTime          @default(now())
  endedAt            DateTime?
  durationSeconds    Int?
  recordingUrl       String?
  transcript         String?
  summary            String?
  sentiment          Sentiment?
  intent             CallIntent?
  intentConfidence   Float?
  outcome            CallOutcome?
  resolutionStatus   ResolutionStatus?
  requiresFollowUp   Boolean           @default(false)
  followUpDeadline   DateTime?
  appointmentId      String?           @unique
  aiRawResult        Json?
  intentOverride     CallIntent?
  outcomeOverride    CallOutcome?
  correctedByUserId  String?
  correctedAt        DateTime?
  qualificationData  Json?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  caller      Caller         @relation(fields: [callerId], references: [id], onDelete: Cascade)
  appointment Appointment?   @relation(fields: [appointmentId], references: [id])
  events      CallEvent[]
  leads       Lead[]
  tasks       FollowUpTask[]
  smsMessages SmsMessage[]

  @@index([tenantId, startedAt])
  @@index([tenantId, resolutionStatus])
}

model CallEvent {
  id             String   @id @default(cuid())
  tenantId       String
  callId         String
  eventType      String
  eventTimestamp DateTime @default(now())
  payload        Json?
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  call   Call   @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([tenantId, callId, eventTimestamp])
}

model Lead {
  id                 String       @id @default(cuid())
  tenantId           String
  callerId           String
  sourceCallId       String?
  source             LeadSource   @default(PHONE)
  status             LeadStatus   @default(NEW)
  priority           LeadPriority @default(MEDIUM)
  serviceRequested   String?
  estimatedValue     Decimal?     @db.Decimal(12, 2)
  qualificationScore Float?
  qualificationData  Json?
  nextAction         String?
  followUpDeadline   DateTime?
  assignedUserId     String?
  lastContactedAt    DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  caller       Caller         @relation(fields: [callerId], references: [id], onDelete: Cascade)
  sourceCall   Call?          @relation(fields: [sourceCallId], references: [id])
  assignedUser User?          @relation("LeadAssignee", fields: [assignedUserId], references: [id])
  appointments Appointment[]
  tasks        FollowUpTask[]

  @@index([tenantId, status])
  @@index([tenantId, followUpDeadline])
  @@index([tenantId, assignedUserId])
}

model Appointment {
  id                      String            @id @default(cuid())
  tenantId                String
  callerId                String
  leadId                  String?
  externalCalendarEventId String?
  title                   String
  description             String?
  startTime               DateTime
  endTime                 DateTime
  timezone                String
  status                  AppointmentStatus @default(PENDING)
  assignedUserId          String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  deletedAt               DateTime?

  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  caller       Caller  @relation(fields: [callerId], references: [id], onDelete: Cascade)
  lead         Lead?   @relation(fields: [leadId], references: [id])
  assignedUser User?   @relation("AppointmentAssignee", fields: [assignedUserId], references: [id])
  call         Call?

  @@index([tenantId, startTime])
  @@index([tenantId, status])
}

model FollowUpTask {
  id             String       @id @default(cuid())
  tenantId       String
  leadId         String?
  callId         String?
  assignedUserId String?
  title          String
  description    String?
  priority       TaskPriority @default(MEDIUM)
  dueAt          DateTime
  status         TaskStatus   @default(OPEN)
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead         Lead?  @relation(fields: [leadId], references: [id])
  call         Call?  @relation(fields: [callId], references: [id])
  assignedUser User?  @relation("TaskAssignee", fields: [assignedUserId], references: [id])

  @@index([tenantId, status, dueAt])
  @@index([tenantId, assignedUserId])
}

model SmsMessage {
  id              String       @id @default(cuid())
  tenantId        String
  callerId        String?
  callId          String?
  twilioMessageSid String?     @unique
  direction       SmsDirection
  body            String
  status          SmsStatus    @default(QUEUED)
  sentAt          DateTime?
  createdAt       DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  caller Caller? @relation(fields: [callerId], references: [id])
  call   Call?   @relation(fields: [callId], references: [id])

  @@index([tenantId, createdAt])
}

model HealthScoreSnapshot {
  id                        String   @id @default(cuid())
  tenantId                  String
  score                     Float
  leadResponseScore         Float?
  callResolutionScore       Float?
  appointmentScore          Float?
  followUpScore             Float?
  opportunityScore          Float?
  customerExperienceScore   Float?
  categoryDetails           Json
  deductions                Json
  summary                   String
  recommendations           Json
  calculationVersion        String
  periodStart               DateTime
  periodEnd                 DateTime
  periodType                String   @default("daily")
  createdAt                 DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, periodEnd])
}

model IntegrationConnection {
  id                           String              @id @default(cuid())
  tenantId                     String
  provider                     IntegrationProvider
  status                       IntegrationStatus   @default(PENDING)
  encryptedCredentialsReference String?
  externalAccountId            String?
  lastSuccessfulSyncAt         DateTime?
  lastError                    String?
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
}

model AuditLog {
  id           String   @id @default(cuid())
  tenantId     String?
  userId       String?
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  ipAddress    String?
  createdAt    DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  tenantId  String
  userId    String?
  type      NotificationType
  title     String
  body      String
  href      String?
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, userId, createdAt])
}

model TwilioInboundNumber {
  id          String   @id @default(cuid())
  tenantId    String
  phoneNumber String   @unique
  label       String?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model ActivityEvent {
  id           String   @id @default(cuid())
  tenantId     String
  eventType    String
  title        String
  description  String?
  resourceType String?
  resourceId   String?
  metadata     Json?
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}
